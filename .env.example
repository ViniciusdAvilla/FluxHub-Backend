APP_NAME=FluxHub
APP_VERSION=1.0.0
ENVIRONMENT=production
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://fluxhub:CHANGE_ME@127.0.0.1:5432/fluxhub
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
MERCADO_LIVRE_CLIENT_ID=YOUR_MERCADO_LIVRE_APP_ID
MERCADO_LIVRE_CLIENT_SECRET=YOUR_MERCADO_LIVRE_SECRET_KEY
MERCADO_LIVRE_REDIRECT_URI=https://myfluxhub.tech/api/v1/connectors/mercado-livre/callback
FRONTEND_URL=https://myfluxhub.tech
TOKEN_ENCRYPTION_KEY=GENERATE_WITH_FERNET
# Obrigatório para APIs privadas; configure o MESMO valor no Next.js (nunca no navegador).
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_TOKEN=
